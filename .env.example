# Kopyala:  cp .env.example .env
# Tum anahtarlar src/config.py icinde tanimli. Buradaki degerler VARSAYILANLAR.

# =====================================================================
#  KAMERA
# =====================================================================
CAM_WEB_URL=http://host.docker.internal:8600   # tools/cam_web.py yayini (host)
SNAP_DIR=snaps
CAM_LEFT_INDEX=0                # tools/cam_web disi dogrudan yakalama icin
CAM_RIGHT_INDEX=2
CAM_WIDTH=1280
CAM_HEIGHT=720

# =====================================================================
#  STEREO / DERINLIK  (ilk deneme degerleri - pipeline gerekirse gevsetir)
# =====================================================================
SGBM_MIN_DISPARITY=0
SGBM_NUM_DISPARITIES=192        # 16'nin kati
SGBM_BLOCK_SIZE=5
SGBM_UNIQUENESS_RATIO=12
SGBM_SPECKLE_WINDOW=100
SGBM_SPECKLE_RANGE=2
WLS_LAMBDA=8000
WLS_SIGMA=1.5
WLS_CONFIDENCE_THRESHOLD=120    # altindaki piksel NaN (gurultu cok -> yukselt)
POINTCLOUD_MAX_POINTS=60000

# =====================================================================
#  OLCUM / OZ-KALIBRASYON
# =====================================================================
# Bilinen boyutlu kutuyla kilitlenir:  python -m tools.calib_scale --dims boy,en,derinlik
MEASURE_SCALE=1.0
# Merkez ROI'de gecerli disparite bunun altina duserse -> otomatik oz-kalibrasyon
SELFCAL_MIN_VALID_FRAC=0.18
# Ayak izleri bu kadar yakin 2B kumeler tek nesnede birlestirilir
# (yumusak cisim: sirt cantasi koyu deri cep/dikis stereo bosluklari)
CLUSTER_MERGE_GAP_MM=35
GROUND_Z_MM=0                   # robot tabaninda zemin Z'si
UP_AXIS=z
CELL_PLANE_SEG=true

# =====================================================================
#  DURUS SINIFLANDIRMA
# =====================================================================
UPRIGHT_MIN_ASPECT=1.15
UPRIGHT_MAX_AXIS_DEG=25
TIPPED_MIN_ASPECT=1.15
TILT_THRESHOLD_DEG=5.0

# =====================================================================
#  YOLO  (sadece tek-nesne / Hucre Modu YOLO yolu; Otomatik Hucre kullanmaz)
# =====================================================================
SEG_WEIGHTS=yolo26s-seg.pt
SEG_WEIGHTS_FALLBACK=yolov8s-seg.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_DEVICE=cpu                 # "cpu" | "0" | "" (otomatik)
# COCO disi test nesneleri icin ek sinif adi kabul et
ACCEPT_CLASS_NAMES=backpack,handbag

# =====================================================================
#  FAIRINO FR3
# =====================================================================
ROBOT_ENABLED=false            # true YAPMADAN once base_T_cam + guvenlik alani
ROBOT_IP=192.168.57.2          # FRC100 Eth0 (yellow e-stop tarafi: 192.168.58.2)
ROBOT_TCP_SPEED=10             # %
ROBOT_LINEAR_MOVES=false       # bu firmware'de ham MoveL/MoveJ bozuk -> JOG kullanilir
ROBOT_SINGULARITY_RETRY=false
ROBOT_HOME_JOINTS=0,-90,90,-90,-90,0
HANDEYE_PATH=src/calibration/handeye.json
STEREO_CALIB_PATH=src/calibration/stereo_calib.yaml
BASE_T_CAM_PATH=src/calibration/base_T_cam.yaml

# =====================================================================
#  JODELL GRIPPER  (Fairino MoveGripper, 0..100)
# =====================================================================
GRIPPER_ENABLED=false          # gercek gripper takilinca true
GRIPPER_INDEX=1
GRIPPER_OPEN_VALUE=100
GRIPPER_CLOSE_VALUE=0
GRIPPER_MAX_OPENING_MM=80      # <<< TEST GRIPPER'INI CETVELLE OLC VE GIR
GRIPPER_FINGER_LEN_MM=40
GRIPPER_SPEED=50
GRIPPER_FORCE=50

# =====================================================================
#  KAVRAMA / YERLESTIRME / TIP-UP
# =====================================================================
GRASP_HEIGHT_FRACTION=0.5
GRASP_APPROACH_MM=120
GRASP_LIFT_MM=150
GRASP_CLEARANCE_MM=8
FLAT_FACE_STD_MM=6
PLACE_POSE=500,0,150,180,0,0   # x,y,z,rx,ry,rz  (mm, derece)
# Cok-nesne: her nesne icin ayri yer.  "x,y,z,rx,ry,rz; x,y,z,rx,ry,rz; ..."
# bos birakilirsa PLACE_POSE'dan otomatik bir sira uretilir
PLACE_SLOTS=
TARGET_YAW_DEG=0
TIPUP_PUSH_HEIGHT_FRAC=0.8
TIPUP_PUSH_DEPTH_MM=120

# =====================================================================
#  OTOMATIK HUCRE DONGUSU
# =====================================================================
AUTO_LOOP_PAUSE_S=2.0
AUTO_MAX_OBJECTS=8
AUTO_MERGE_FRAMES=1            # >1: sabit sahneden N cift birlestir (daha stabil olcu)
