{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "env": { "ROBOT_ENABLED": "false" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "CLI: tek olcum (run_cli.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_cli.py",
      "args": [
        "sample_data/left.jpg",
        "sample_data/right.jpg",
        "--known-width", "40",
        "--json"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pytest: tum testler",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
